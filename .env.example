# Vorlage — echte Werte in .env eintragen (NIEMALS committen)
# .env ist über .gitignore geschützt.

# Supabase (aus Dashboard → Project Settings → API)
SUPABASE_URL=https://DEIN_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=hier_nur_lokal_niemals_committen
SUPABASE_ANON_KEY=

# Supabase Project Ref (aus Project Settings → General)
SUPABASE_PROJECT_REF=

# Hinweis: Die Edge Functions bekommen SUPABASE_URL und
# SUPABASE_SERVICE_ROLE_KEY in der Cloud AUTOMATISCH — du musst sie
# dort nicht setzen. Diese .env ist nur für lokale CLI-Nutzung.
